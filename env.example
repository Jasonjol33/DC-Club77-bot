TOKEN=dein_bot_token
CLIENT_ID=application_id_des_bots
GUILD_ID=id_deines_servers

# Standard: Rollen-IDs, die Verwaltungsbefehle nutzen dürfen (kommagetrennt)
# Gilt für alle Befehle, für die unten KEINE eigene Rollenliste gesetzt ist.
STAFF_ROLE_IDS=123456789012345678,234567890123456789
# ───────── Optik (optional) ─────────
# Großes Bild unten in jedem Embed (direkter Bild-Link, z.B. von Discord oder imgur)
BANNER_URL=
# Logo oben links im Embed (sonst wird das Server-Icon genommen)
LOGO_URL=
# Private Nachricht an Mitarbeiter bei Einstellung/Beförderung/Degradierung/Kündigung
# true = senden, false = nicht senden
DM_ENABLED=true

# Channel-IDs (optional, aber empfohlen)
LOG_CHANNEL_ID=
URLAUB_CHANNEL_ID=
TICKET_CHANNEL_ID=
# Hier werden /event-Ankündigungen gepostet (leer = im aktuellen Channel)
EVENT_CHANNEL_ID=

# ───────── Rechte pro Befehl (optional) ─────────
# Format: ROLES_<BEFEHLSNAME>=rollenID1,rollenID2
# - Gesetzt   -> NUR diese Rollen dürfen den Befehl nutzen
# - Leer      -> Standard (STAFF_ROLE_IDS; bei /urlaub, /ticket, /commands jeder)
# - Admins dürfen immer alles.
ROLES_EINSTELLEN=
ROLES_RANKUP=
ROLES_DEGRADIEREN=
ROLES_KUENDIGEN=
ROLES_AUSGANG=
ROLES_GESPREACH=
ROLES_ABWESEND=
ROLES_LIZENS=
ROLES_VISUM=
ROLES_ADDJOB=
ROLES_URLAUB=
ROLES_TICKET=
ROLES_COMMANDS=
# Wer Urlaubsanträge per Button genehmigen/ablehnen darf (mehrere Rollen mit Komma, leer = STAFF_ROLE_IDS)
ROLES_URLAUB_VERWALTUNG=